# Copier en .env puis remplir. Ne JAMAIS committer le .env.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://superapp:superapp@localhost:5432/superapp
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Origines autorisées (séparées par des virgules) ; vide = aucune (apps natives seulement)
CORS_ORIGINS=
# Nombre de proxys/répartiteurs de confiance devant l'API (0 en local)
TRUST_PROXY_HOPS=0
# Frais de protection acheteur en points de base (100 = 1 %). DÉCISION COMMERCIALE : [À DÉFINIR]
BUYER_FEE_BPS=
BUYER_FEE_FIXED_XAF=0
# sandbox (dev) | notchpay
PAYMENT_PROVIDER=sandbox
NOTCHPAY_API_KEY=
NOTCHPAY_WEBHOOK_HASH=
PAYMENT_CALLBACK_URL=http://localhost:8080/payments/return
SANDBOX_WEBHOOK_SECRET=change-me-dev-only
